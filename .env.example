# ==============================================================================
# AI Startup Co-Founder Team - Environment Configuration
# ==============================================================================

# LLM Provider Options: 'openrouter', 'openai', 'gemini', 'anthropic', 'ollama'
LLM_PROVIDER=openrouter

# Primary API Keys
OPENROUTER_API_KEY=
LLM_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Model Selections
# OpenRouter format: 'openai/gpt-4o', 'anthropic/claude-3.5-sonnet', 'google/gemini-2.0-flash', 'deepseek/deepseek-chat'
MODEL_DEFAULT=openai/gpt-4o
MODEL_CRITIC=google/gemini-2.0-flash

# Search API (Tavily, SerpAPI, DuckDuckGo)
SEARCH_PROVIDER=duckduckgo
SEARCH_API_KEY=

# Database & Cache (Local SQLite recommended)
DATABASE_URL=sqlite+aiosqlite:///./cofounder.db
DATABASE_SYNC_URL=sqlite:///./cofounder.db
REDIS_URL=redis://localhost:6379/0

# Security & Auth
JWT_SECRET=super-secret-dev-jwt-key-replace-in-production
API_KEY=dev-api-key-12345
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Pipeline, Run Modes & Cost Constraints
# Mode: 'single_agent' | 'multi_no_debate' | 'multi_debate'
MODE=multi_debate
SCORE_THRESHOLD=7.0
DEBATE_MAX_ROUNDS=2
MAX_RETRIES_PER_AGENT=2
MAX_TOKENS_PER_RUN=80000
MAX_BUDGET_USD_PER_RUN=2.00
RATE_LIMIT_RUNS_PER_HOUR=10

# Observability & Distributed Tracing (Optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-startup-cofounder
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Storage
EXPORTS_DIR=./exports_storage
