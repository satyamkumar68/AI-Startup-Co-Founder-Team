# Set default behavior to automatically normalize line endings
* text=auto

# Explicitly declare text files that should always use LF line endings
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf
.env.example text eol=lf

# Explicitly declare Windows batch scripts that require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Denote all binary files that should not have line endings modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.pptx binary
*.db binary
*.sqlite binary
